# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# 1 = Telegram test DC (separate accounts, see core.telegram.org/api/auth#test-accounts)
TG_USE_TEST_DC=0

# TDLib log verbosity: 0 fatal, 1 errors, 2 warnings, 3 info, 4+ debug
TD_LOG_LEVEL=1

# Python log level
LOG_LEVEL=WARNING

# Optional overrides
# TDJSON_PATH=/absolute/path/to/libtdjson.dylib
# TG_DATA_DIR=/absolute/path/to/data

# UI theme: system | light | dark
# TGC_THEME=system
